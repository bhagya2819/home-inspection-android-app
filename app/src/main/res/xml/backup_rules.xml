<?xml version="1.0" encoding="utf-8"?>
<!-- Client data must not leave the device through Google backup; the Home Inspection server is the backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
