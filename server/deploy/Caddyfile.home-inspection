# Appended to /opt/bondverse/Caddyfile (shared Caddy). Reload: docker exec bondverse-caddy-1 caddy reload --config /etc/caddy/Caddyfile
api.homeinspection.example {
    encode gzip
    request_body {
        max_size 64MB
    }
    reverse_proxy home-inspection-api:8080 {
        header_up X-Real-IP {remote_host}
    }
}
